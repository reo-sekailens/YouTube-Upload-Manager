{
  "name": "youtube-upload-manager",
  "private": true,
  "version": "0.1.9",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:ffprobe": "node --test scripts/prepare-ffprobe.tests.mjs",
    "performance:frontend": "npm run build && node scripts/performance/frontend-baseline.mjs",
    "performance:frontend:check": "npm run build && node scripts/performance/frontend-baseline.mjs --check",
    "performance:package:windows": "node scripts/performance/build-windows-harness.mjs",
    "performance:native": "pwsh -NoProfile -File scripts/performance/measure-native-scale.ps1",
    "performance:native:check": "node scripts/performance/native-budget-check.mjs",
    "prepare:ffprobe": "node scripts/prepare-ffprobe.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-opener": "^2.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
